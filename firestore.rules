rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.players.keys().hasAny([request.auth.uid])
        && request.resource.data.status == 'lobby';
      allow read: if request.auth != null
        && (resource.data.hostUid == request.auth.uid
            || resource.data.players.keys().hasAny([request.auth.uid]));
      // Starter rules only: suitable for testing with trusted friends, not cheat-resistant public tournaments.
      allow update: if request.auth != null
        && (resource.data.hostUid == request.auth.uid
            || resource.data.players.keys().hasAny([request.auth.uid])
            || request.resource.data.players.keys().hasAny([request.auth.uid]));
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
  }
}

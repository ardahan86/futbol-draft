rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      // Rooms are discoverable only by code in the UI, but authenticated clients
      // need read access to validate a six-digit join code.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberOrder.size() == 1
        && request.resource.data.status == 'lobby'
        && request.resource.data.code == roomId;

      allow update: if request.auth != null
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          // Existing member actions (start, pick, captain, or leave before draft)
          (request.auth.uid in resource.data.members
            && request.resource.data.members.keys().hasAll([resource.data.hostUid]))
          ||
          // A new member may join only while the room is waiting, adding only themselves.
          (resource.data.status == 'lobby'
            && !(request.auth.uid in resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.memberOrder.size() == resource.data.memberOrder.size() + 1
            && request.resource.data.memberOrder.hasAll(resource.data.memberOrder)
            && request.resource.data.status == resource.data.status
            && request.resource.data.picks == resource.data.picks)
        );

      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
  }
}
